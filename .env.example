# == APIMart (制作台文本、图片、视频及 Gemini Flash) ==
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_STUDIO_MODEL=gpt-6-luna
# 制作台媒体固定使用 gpt-image-2.5-flare（16:9 / 1k / medium）
# 与 MiniMax-H3-Max（首帧图生视频 / 1080P），共用上述密钥和基础地址。

# == 302.ai (Required) ==
AI302_API_KEY=s******************

# == Models ==
AI302_TEXT_MODEL=gemini-3.5-flash-lite
AI302_TEXT_FALLBACK=gemini-3.7-flash
AI302_VISION_MODEL=gemini-3.5-flash-lite
AI302_STORYBOARD_MODEL=gemini-3.5-flash-lite
AI302_IMAGE_GEN_MODEL=gemini-2.0-pro-image-preview
AI302_VIDEO_GEN_MODEL=kling-v1-5-pro
AI302_AUDIO_MODEL=whisper-1

# == TokenStar（仅旧兼容函数，当前制作台不再使用）==
# 请在本机 .env 填入 TokenStar 密钥；不要提交 .env。
TOKENSTAR_API_KEY=
TOKENSTAR_BASE_URL=https://api.tokenstar.world
TOKENSTAR_IMAGE_MODEL=gpt-image-2
# 影视制作台首帧图：优先直接请求原生 16:9；服务端会校验最终比例。
TOKENSTAR_IMAGE_SOURCE_SIZE=2048x1152
# TokenStar 生图为同步请求；复杂图生图可等待至 5 分钟，超时不判失败（后台可能仍在生成）。
TOKENSTAR_IMAGE_TIMEOUT_SECONDS=300
# 导演脚本图片动态化：TokenStar Seedance 素材模型。
TOKENSTAR_SEEDANCE_MODEL=seedance-2.0-asset-fast
TOKENSTAR_SEEDANCE_ASSET_MODEL=volc-asset
TOKENSTAR_ASSET_POLL_INTERVAL_MS=1500
TOKENSTAR_ASSET_MAX_POLL_ATTEMPTS=20
TOKENSTAR_ASSET_VIDEO_CREATE_RETRY_MS=5000
TOKENSTAR_ASSET_VIDEO_CREATE_MAX_ATTEMPTS=8
# 旧制作台兼容配置（其他仍调用 Kling 的页面继续使用）。
TOKENSTAR_KLING_MODEL=kling-v3
TOKENSTAR_KLING_SOUND=on
# 当前服务的公网 HTTPS 域名，用于提供一次性视频首帧。
# 未配置 Bunny 或公网域名时，制作台会使用 APIMart 官方上传接口。
PUBLIC_BASE_URL=

# == Bunny Storage（推荐：为视频模型临时提供可拉取的 HTTPS 首帧）==
# 可与 Mindverse 使用同一 Bunny 账户，但请在「念念」环境中独立配置，不要读取其他项目的 .env.local。
BUNNY_STORAGE_ZONE=
BUNNY_ACCESS_KEY=
BUNNY_STORAGE_REGION=sg
BUNNY_PULL_ZONE_URL=
BUNNY_UPLOAD_TIMEOUT_SECONDS=180
BUNNY_REQUEST_TIMEOUT_SECONDS=120
BUNNY_CDN_READY_ATTEMPTS=8
BUNNY_CDN_READY_INTERVAL_SECONDS=1.5

# == Kling (可灵) 官方视频生成 API ==
# 新版（推荐）：单个 Bearer API Key，从可灵官方控制台生成。
# 配置了它就会优先使用新版 /image-to-video/{model} 接口。
KLING_API_KEY=
KLING_MODEL_NAME=kling-3.0-turbo
# 旧版（已废弃，仅兼容保留）：AccessKeyId+Secret 签 JWT，走 /v1/videos/image2video。
# 只有在 KLING_API_KEY 未配置时才会尝试用这组旧凭据。
KLING_ACCESS_KEY_ID=
KLING_ACCESS_KEY_SECRET=

# == Diary ASR only ==
# auto / dashscope / dashscope_realtime / 302 / llm
DIARY_ASR_PROVIDER=auto
# Used when DIARY_ASR_PROVIDER=302, or when auto falls back to 302.
# Keep this separate from AI302_AUDIO_MODEL if other voice features need a different ASR model.
DIARY_ASR_MODEL=whisper-1
# Used when DIARY_ASR_PROVIDER=dashscope, or when auto tries DashScope first.
DIARY_DASHSCOPE_ASR_MODELS=paraformer-realtime-v2
# Used when DIARY_ASR_PROVIDER=dashscope_realtime. Upload WAV/PCM; backend streams PCM chunks to Qwen Omni.
DIARY_DASHSCOPE_REALTIME_MODEL=qwen3.5-omni-plus-realtime
DIARY_DASHSCOPE_REALTIME_TIMEOUT=25
# Used when DIARY_ASR_PROVIDER=llm. The model must support audio input in chat/completions.
DIARY_LLM_AUDIO_MODEL=gemini-3.5-flash-lite
# transcribe: audio to original text; translate: audio to target language.
DIARY_LLM_AUDIO_TASK=transcribe
DIARY_LLM_AUDIO_TARGET_LANG=中文

# == Alibaba Qwen (NianNian Agent voice chat) ==
# Get key: https://www.alibabacloud.com/help/en/model-studio/get-api-key
DASHSCOPE_API_KEY=sk-**************************
# intl=国际站；cn=中国站。Key 与区域必须对应。
DASHSCOPE_REGION=intl
# == QwenCloud voice clone / cloned-voice TTS ==
# QwenCloud key only; leave blank to fall back to DASHSCOPE_API_KEY.
# Use a separate key here if other features still use Alibaba DashScope.
QWEN_API_KEY=
QWEN_DASHSCOPE_BASE_URL=https://maas.qwencloudapi.com/api/v1
# Optional; normally derived from the HTTP base host.
QWEN_TTS_WEBSOCKET_URL=
# Reference audio must be accessible via existing Bunny CDN or HTTPS PUBLIC_BASE_URL.
# Do not use an Alibaba aliyuncs.com endpoint for this voice-clone flow.
# 素材库图片理解与语义检索（使用同一 DashScope Key）。
NIAN_ASSET_VISION_MODEL=qwen-vl-plus
NIAN_ASSET_RERANK_MODEL=qwen-plus
NIAN_ASSET_TEXT_MODEL=qwen-plus

# == Optional local LLM ==
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# LOCAL_LLM_API_KEY=lm-studio
# LOCAL_LLM_MODEL=qwen3:8b
