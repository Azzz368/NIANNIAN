# == 302.ai (Required) ==
AI302_API_KEY=s******************

# == Models ==
AI302_TEXT_MODEL=gemini-2.5-flash
AI302_TEXT_FALLBACK=claude-sonnet-4-6
AI302_VISION_MODEL=gemini-2.0-pro-image-preview
AI302_IMAGE_GEN_MODEL=gemini-2.0-pro-image-preview
AI302_VIDEO_GEN_MODEL=kling-v1-5-pro
AI302_AUDIO_MODEL=whisper-1

# == TokenStar（影视制作台图片生成：gpt-image-2）==
# 请在本机 .env 填入 TokenStar 密钥；不要提交 .env。
TOKENSTAR_API_KEY=
TOKENSTAR_BASE_URL=https://api.tokenstar.world
TOKENSTAR_IMAGE_MODEL=gpt-image-2
# “数”模块的真人三视图 + 表情九宫格，使用 TokenStar Gemini 3 Pro 图像模型。
TOKENSTAR_CHARACTER_SHEET_MODEL=gemini-3-pro-image-preview
# 影视制作台首帧图：优先直接请求原生 16:9；服务端会校验最终比例。
TOKENSTAR_IMAGE_SOURCE_SIZE=2048x1152
# 影视制作台图生视频，默认启用 Kling 音频生成。
TOKENSTAR_KLING_MODEL=kling-v3
TOKENSTAR_KLING_SOUND=on
# 部署域名或本地 HTTPS 隧道地址；用于让 TokenStar 下载分镜首帧。
# 生产环境留空时会尝试从当前请求自动识别，本地 localhost 测试建议显式填写。
PUBLIC_BASE_URL=

# == Kling (可灵) 官方视频生成 API ==
# 新版（推荐）：单个 Bearer API Key，从可灵官方控制台生成。
# 配置了它就会优先使用新版 /image-to-video/{model} 接口，也用于数字人测试页。
KLING_API_KEY=
KLING_MODEL_NAME=kling-3.0-turbo
# 可灵官方数字人接口（图片 + 音频 → 口型视频）。
KLING_AVATAR_BASE_URL=https://api-beijing.klingai.com
# 旧版（已废弃，仅兼容保留）：AccessKeyId+Secret 签 JWT，走 /v1/videos/image2video。
# 只有在 KLING_API_KEY 未配置时才会尝试用这组旧凭据。
KLING_ACCESS_KEY_ID=
KLING_ACCESS_KEY_SECRET=

# == Diary ASR only ==
# auto / dashscope / dashscope_realtime / 302 / llm
DIARY_ASR_PROVIDER=auto
# Used when DIARY_ASR_PROVIDER=302, or when auto falls back to 302.
# Keep this separate from AI302_AUDIO_MODEL if other voice features need a different ASR model.
DIARY_ASR_MODEL=whisper-1
# Used when DIARY_ASR_PROVIDER=dashscope, or when auto tries DashScope first.
DIARY_DASHSCOPE_ASR_MODELS=paraformer-realtime-v2
# Used when DIARY_ASR_PROVIDER=dashscope_realtime. Upload WAV/PCM; backend streams PCM chunks to Qwen Omni.
DIARY_DASHSCOPE_REALTIME_MODEL=qwen3.5-omni-plus-realtime
DIARY_DASHSCOPE_REALTIME_TIMEOUT=25
# Used when DIARY_ASR_PROVIDER=llm. The model must support audio input in chat/completions.
DIARY_LLM_AUDIO_MODEL=gemini-2.5-flash
# transcribe: audio to original text; translate: audio to target language.
DIARY_LLM_AUDIO_TASK=transcribe
DIARY_LLM_AUDIO_TARGET_LANG=中文

# == Alibaba Qwen (NianNian Agent voice chat) ==
# Get key: https://www.alibabacloud.com/help/en/model-studio/get-api-key
DASHSCOPE_API_KEY=sk-**************************

# == Optional local LLM ==
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# LOCAL_LLM_API_KEY=lm-studio
# LOCAL_LLM_MODEL=qwen3:8b
